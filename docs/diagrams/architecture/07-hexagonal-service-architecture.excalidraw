    {"type":"text","id":"infra_t","x":40,"y":438,"width":880,"height":65,"text":"INFRASTRUCTURE — External system adapters, database, cache\n\nDrizzle ORM repositories  │  Redis cache adapters  │  OpenFGA RelationshipWriter\n8 PostgreSQL repository implementations — implements Domain interfaces","originalText":"INFRASTRUCTURE — External system adapters, database, cache\n\nDrizzle ORM repositories  │  Redis cache adapters  │  OpenFGA RelationshipWriter\n8 PostgreSQL repository implementations — implements Domain interfaces","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700403,"version":1,"versionNonce":700404,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"infra_layer","lineHeight":1.25},


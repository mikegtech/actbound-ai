    {"type":"text","id":"title","x":220,"y":8,"width":500,"height":30,"text":"Hexagonal Service Architecture","originalText":"Hexagonal Service Architecture","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700001,"version":1,"versionNonce":700002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":220,"y":40,"width":500,"height":16,"text":"NestJS services — ADR-004 strict layer import rules","originalText":"NestJS services — ADR-004 strict layer import rules","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700003,"version":1,"versionNonce":700004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"pres_layer","x":30,"y":80,"width":900,"height":70,"strokeColor":"#c2410c","backgroundColor":"#fed7aa","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700101,"version":1,"versionNonce":700102,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"pres_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"pres_t","x":40,"y":95,"width":880,"height":40,"text":"PRESENTATION — HTTP controllers, routes, request/response mapping\nControllers, Guards, Pipes, Interceptors — depends on Application layer","originalText":"PRESENTATION — HTTP controllers, routes, request/response mapping\nControllers, Guards, Pipes, Interceptors — depends on Application layer","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700103,"version":1,"versionNonce":700104,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"pres_layer","lineHeight":1.25},

    {"type":"rectangle","id":"app_layer","x":30,"y":170,"width":900,"height":120,"strokeColor":"#1e3a5f","backgroundColor":"#3b82f6","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700201,"version":1,"versionNonce":700202,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"app_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"app_t","x":40,"y":178,"width":880,"height":105,"text":"APPLICATION — Business logic orchestration, use cases\n\nAssistantRuntimeService  │  AuthorizationService  │  DelegatedAccessService\nTokenBrokerService       │  AuditService          │  ObservabilityService\nResilienceService        │  RelationshipService   │  ResourceAccessService\n\nDepends on Domain layer — implements use cases via domain interfaces","originalText":"APPLICATION — Business logic orchestration, use cases\n\nAssistantRuntimeService  │  AuthorizationService  │  DelegatedAccessService\nTokenBrokerService       │  AuditService          │  ObservabilityService\nResilienceService        │  RelationshipService   │  ResourceAccessService\n\nDepends on Domain layer — implements use cases via domain interfaces","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700203,"version":1,"versionNonce":700204,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"app_layer","lineHeight":1.25},

    {"type":"rectangle","id":"domain_layer","x":30,"y":310,"width":900,"height":100,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700301,"version":1,"versionNonce":700302,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"dom_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"dom_t","x":40,"y":318,"width":880,"height":85,"text":"DOMAIN — Pure business types, interfaces, value objects (zero dependencies)\n\nPrincipal  │  AssistantRepository (interface)  │  AuditEventStore (interface)\nUserRepository  │  OrganizationRepository  │  ResourceRepository\nBreak-glass types  │  Compromise response types  │  Recovery order types\n\nNo imports from Application, Infrastructure, or Presentation","originalText":"DOMAIN — Pure business types, interfaces, value objects (zero dependencies)\n\nPrincipal  │  AssistantRepository (interface)  │  AuditEventStore (interface)\nUserRepository  │  OrganizationRepository  │  ResourceRepository\nBreak-glass types  │  Compromise response types  │  Recovery order types\n\nNo imports from Application, Infrastructure, or Presentation","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700303,"version":1,"versionNonce":700304,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"domain_layer","lineHeight":1.25},


{
  "name": "@actbound/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@actbound/sdk": "workspace:*",
    "@actbound/ui": "workspace:*",
    "@auth0/auth0-react": "^2.15.0",

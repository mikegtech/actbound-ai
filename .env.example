# ActBound AI — Environment Variables
# Use the relevant sections below as package-specific templates.
# This monorepo does not rely on one shared root .env for every package.
#
# Copy the values you need into:
# - services/orchestrator-api/.env
# - services/agent-service/.env
# - apps/web/.env.local
#
# Never commit .env files with real secrets.
#
# .env is git-ignored. Only .env.example is tracked.

# ── services/orchestrator-api/.env ──────────────────────────────────
PORT=3001
# Comma-separated browser origins allowed to call the external orchestrator API.
ORCHESTRATOR_CORS_ORIGINS=http://localhost:5173

# ── services/agent-service/.env ─────────────────────────────────────
PORT=3002
# Leave unset unless you intentionally expose the internal agent service to a browser client.
# AGENT_CORS_ORIGINS=http://localhost:5173

# ── apps/web/.env.local ─────────────────────────────────────────────
# VITE_ORCHESTRATOR_API_URL=http://localhost:3001

# ── Auth0 (orchestrator-api) ──────────────────────────────────────────
# AUTH0_DOMAIN=dev-6az71xw7wqwtmp0q.us.auth0.com
# AUTH0_ISSUER_BASE_URL=https://dev-6az71xw7wqwtmp0q.us.auth0.com/
# AUTH0_AUDIENCE=https://api.actbound.dev
# AUTH0_M2M_CLIENT_ID=<from actbound-m2m app>
# AUTH0_M2M_CLIENT_SECRET=<from actbound-m2m app>

# ── Auth0 (agent-service — JWT validation only, no M2M minting) ─────
# AUTH0_DOMAIN=dev-6az71xw7wqwtmp0q.us.auth0.com
# AUTH0_ISSUER_BASE_URL=https://dev-6az71xw7wqwtmp0q.us.auth0.com/
# AUTH0_AUDIENCE=https://api.actbound.dev

# ── Auth0 (apps/web — SPA, use VITE_ prefix) ────────────────────────
# VITE_AUTH0_DOMAIN=dev-6az71xw7wqwtmp0q.us.auth0.com
# VITE_AUTH0_CLIENT_ID=<from actbound-web app>
# VITE_AUTH0_AUDIENCE=https://api.actbound.dev
# VITE_AUTH0_CALLBACK_URL=http://localhost:5173/callback

# ── Redis ────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
